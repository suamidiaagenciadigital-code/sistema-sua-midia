        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Client-Token", "value": "Fe00dc9584e8840d09e8fba90984de044S" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "bodyContentType": "json",
        "jsonBody": "={{ {phone: $json.groupJid, message: 'Planejamento semanal para aprovacao\\n\\nOla! Segue o conteudo planejado para a semana de ' + $json.weekStart + ' a ' + $json.weekEnd + '.\\n\\nPor favor, avalie cada publicacao abaixo e clique em Aprovar ou Corrigir.'} }}",
        "options": {}
      },
      "id": "send-intro-message",
      "name": "Z-API — enviar mensagem introdutória",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
