        "headerParameters": {
          "parameters": [
            { "name": "x-webhook-secret", "value": "suamidia@2026" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "bodyContentType": "json",
        "jsonBody": "={{ {clientId: $json.body.clientId, weekStart: $json.body.weekStart, weekEnd: $json.body.weekEnd} }}",
        "options": {}
      },
      "id": "get-week-contents",
      "name": "Buscar conteúdos da semana",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.contents.length }}",
