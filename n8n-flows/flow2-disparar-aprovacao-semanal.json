    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nreturn [{ json: { groupJid: data.groupJid, contents: data.contents, weekStart: $('Webhook — disparar aprovação (sistema)').item.json.body.weekStart, weekEnd: $('Webhook — disparar aprovação (sistema)').item.json.body.weekEnd } }];"
      },
