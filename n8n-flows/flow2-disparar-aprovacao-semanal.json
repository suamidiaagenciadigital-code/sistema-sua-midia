              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "check-has-contents",
      "name": "Tem conteúdos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"Nenhum conteudo aprovado para a semana\" }",
