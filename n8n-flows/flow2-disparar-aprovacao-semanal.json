      "id": "webhook-trigger",
      "name": "Webhook — disparar aprovação (sistema)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "disparar-aprovacao"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sistema-sua-midia.vercel.app/api/webhooks/n8n/get-week-contents",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-webhook-secret", "value": "suamidia@2026" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "bodyContentType": "json",
        "jsonBody": "={{ {clientId: $json.body.clientId, weekStart: $json.body.weekStart, weekEnd: $json.body.weekEnd} }}",
        "options": {}
      },
      "id": "get-week-contents",
      "name": "Buscar conteúdos da semana",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.contents.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "id": "check-has-contents",
      "name": "Tem conteúdos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"Nenhum conteudo aprovado para a semana\" }",
        "options": { "responseCode": 422 }
      },
      "id": "respond-no-content",
      "name": "Responder — sem conteúdo",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 500]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst wb = $('Webhook — disparar aprovação (sistema)').item.json.body;\nconst count = data.contents.length;\nconst plural = count > 1 ? 'publicacoes' : 'publicacao';\nconst msg = '📅 *Planejamento da semana — ' + wb.weekStart + ' a ' + wb.weekEnd + '*' +\n  '\\n\\n' + data.client.name + ', voce tem *' + count + ' ' + plural + '* aguardando aprovacao.' +\n  '\\n\\nAcesse o link abaixo para visualizar o criativo, a legenda e aprovar ou pedir alteracoes:' +\n  '\\n\\n🔗 ' + data.approvalUrl;\nreturn [{ json: { groupJid: data.groupJid, approvalUrl: data.approvalUrl, message: msg, clientId: wb.clientId, weekStart: wb.weekStart, weekEnd: wb.weekEnd } }];"
      },
      "id": "prepare-message",
      "name": "Preparar mensagem com link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.z-api.io/instances/3F1910AF0A4BB2829C31AAE399BC1248/token/3F1A9C63F60F02131FE11D1F/send-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Client-Token", "value": "Fe00dc9584e8840d09e8fba90984de044S" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "bodyContentType": "json",
        "jsonBody": "={{ {phone: $json.groupJid, message: $json.message} }}",
        "options": {}
      },
      "id": "send-link",
      "name": "Z-API — enviar link de aprovação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sistema-sua-midia.vercel.app/api/webhooks/n8n/mark-all-sent-to-client",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-webhook-secret", "value": "suamidia@2026" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "bodyContentType": "json",
        "jsonBody": "={{ {clientId: $json.clientId, weekStart: $json.weekStart, weekEnd: $json.weekEnd} }}",
        "options": {}
      },
      "id": "mark-all-sent",
      "name": "Sistema — marcar todos como enviados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok: true, approvalUrl: $('Preparar mensagem com link').item.json.approvalUrl} }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 300]
    }
  ],
