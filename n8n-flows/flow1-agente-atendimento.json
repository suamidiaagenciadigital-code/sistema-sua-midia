            { "name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $('Webhook Z-API (mensagem recebida)').item.json.body.senderPhone }}\",\n  \"message\": \"{{ $('Webhook Z-API (mensagem recebida)').item.json.body.text.message }}\",\n  \"client_id\": \"{{ $('Buscar cliente pelo grupo').item.json.client.id }}\"\n}",
        "options": {}
      },
