      "parameters": {
        "jsCode": "const inputData = $input.item.json;\nconst client = inputData.client || {};\nlet message = \"ola\";\nlet chatId = \"\";\nlet senderPhone = \"\";\ntry {\n  const wb = $(\"Webhook Z-API (mensagem recebida)\").item.json;\n  if (wb.body && wb.body.text && wb.body.text.message) message = wb.body.text.message;\n  else if (wb.body && wb.body.message) message = wb.body.message;\n  chatId = wb.body.chatId || \"\";\n  senderPhone = wb.body.senderPhone || \"\";\n} catch(e) {}\nconst sys = \"Voce e um assistente de atendimento da agencia Sua Midia. Cliente: \" + (client.name || \"Cliente\") + \". Seja humanizado, cordial e profissional. Se nao souber responder diga: Vou verificar com a equipe! Nunca mencione que e IA.\";\nreturn [{ json: { model: \"claude-sonnet-4-5\", max_tokens: 500, system: sys, messages: [{ role: \"user\", content: message }], _chatId: chatId, _senderPhone: senderPhone, _clientId: client.id || \"\", _message: message } }];"
      },
